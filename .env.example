# Final HTTPS origin, without a path. Required for canonicals, schema and social images.
NEXT_PUBLIC_SITE_URL=https://tokisushi.pt

# Keep false in development and staging. Set true ONLY for the production build
# when launching. Vercel preview/development deployments always remain noindex.
# Rebuild/redeploy after changing either value. See docs/seo-launch.md.
SEO_INDEXING_ENABLED=false

# Optional Google Search Console HTML verification token (not the whole meta tag).
GOOGLE_SITE_VERIFICATION=
